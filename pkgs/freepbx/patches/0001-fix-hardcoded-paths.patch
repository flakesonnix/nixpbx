From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FreePBX Nix Packager <l+git@gelbetasse.org>
Date: Wed, 01 Jan 2025 00:00:00 +0000
Subject: [PATCH] fix: replace hardcoded FHS paths with configurable constants

FreePBX assumes a classic FHS layout with paths like /var/www/html,
/etc/asterisk, and /var/log/asterisk baked into PHP source. This patch
replaces those occurrences with PHP constants (AMPWEBROOT, ASTETCDIR,
ASTLOGDIR, ASTSPOOLDIR) that are already defined in freepbx.conf and
loaded at bootstrap, making the code path-agnostic at build time.
---
 admin/libraries/BMO/Self_Helper.class.php | 4 ++--
 admin/libraries/utility.functions.php     | 8 ++++----
 amp_conf/htdocs/admin/bootstrap.php       | 6 +++---
 install                                   | 4 ++--
 4 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/admin/libraries/BMO/Self_Helper.class.php b/admin/libraries/BMO/Self_Helper.class.php
index 1111111..2222222 100644
--- a/admin/libraries/BMO/Self_Helper.class.php
+++ b/admin/libraries/BMO/Self_Helper.class.php
@@ -18,7 +18,7 @@
 class Self_Helper {
 	public function getModuleDirs() {
 		return [
-			'/var/www/html/admin/modules',
+			AMPWEBROOT . '/admin/modules',
 			AMPWEBROOT . '/admin/modules',
 		];
 	}
@@ -28,7 +28,7 @@ class Self_Helper {
 	public function getLogDir() {
-		return '/var/log/asterisk';
+		return defined('ASTLOGDIR') ? ASTLOGDIR : '/var/log/asterisk';
 	}

 	public function getSpoolDir() {
-		return '/var/spool/asterisk';
+		return defined('ASTSPOOLDIR') ? ASTSPOOLDIR : '/var/spool/asterisk';
 	}
 }
diff --git a/admin/libraries/utility.functions.php b/admin/libraries/utility.functions.php
index 3333333..4444444 100644
--- a/admin/libraries/utility.functions.php
+++ b/admin/libraries/utility.functions.php
@@ -45,10 +45,10 @@ function getWebRoot() {
-	$candidates = ['/var/www/html', '/var/www', '/srv/www'];
+	$candidates = [AMPWEBROOT, '/var/www/html', '/var/www', '/srv/www'];
 	foreach ($candidates as $dir) {
 		if (is_dir($dir . '/admin')) {
 			return $dir;
 		}
 	}
-	return '/var/www/html';
+	return AMPWEBROOT;
 }

 function getEtcDir() {
-	return '/etc/asterisk';
+	return defined('ASTETCDIR') ? ASTETCDIR : '/etc/asterisk';
 }
diff --git a/amp_conf/htdocs/admin/bootstrap.php b/amp_conf/htdocs/admin/bootstrap.php
index 5555555..6666666 100644
--- a/amp_conf/htdocs/admin/bootstrap.php
+++ b/amp_conf/htdocs/admin/bootstrap.php
@@ -12,7 +12,7 @@
 // Locate freepbx.conf — check env override first for Nix compatibility
-$freepbx_conf_locations = ['/etc/freepbx.conf', '/etc/asterisk/freepbx.conf'];
+$freepbx_conf_locations = [
+	getenv('FREEPBX_CONF') ?: '',
+	'/etc/freepbx.conf',
+	'/etc/asterisk/freepbx.conf',
+];
 foreach ($freepbx_conf_locations as $loc) {
-	if (file_exists($loc)) {
+	if ($loc && file_exists($loc)) {
 		require_once($loc);
 		break;
 	}
diff --git a/install b/install
index 7777777..8888888 100755
--- a/install
+++ b/install
@@ -88,8 +88,8 @@ function check_requirements() {
-	$webroot = '/var/www/html';
-	$etcdir  = '/etc/asterisk';
+	$webroot = defined('AMPWEBROOT') ? AMPWEBROOT : '/var/www/html';
+	$etcdir  = defined('ASTETCDIR')  ? ASTETCDIR  : '/etc/asterisk';
 	check_dir_writable($webroot);
 	check_dir_writable($etcdir);
 }
--
